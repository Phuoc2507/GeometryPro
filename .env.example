# Required for AI Draw and Solve in local development.
VILAO_API_KEY=replace_with_your_vilao_key

# Optional: needed when testing authenticated Supabase and credit flows locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key

# Required for anonymous server-side AI trial quotas. Generate a long random
# value and keep it server-only (never use a VITE_ prefix).
GUEST_QUOTA_SECRET=replace_with_at_least_32_random_characters

# PayOS checkout/webhook (server-only).
PAYOS_CLIENT_ID=replace_with_your_payos_client_id
PAYOS_API_KEY=replace_with_your_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_your_payos_checksum_key

# Canonical public origin used to validate checkout return/cancel URLs.
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Optional anti-abuse ceiling: number of guest devices allowed per IP quota.
GUEST_IP_DAILY_MULTIPLIER=20

# Optional client error tracking (Sentry). Leave empty to disable — the app
# no-ops when the DSN is absent. The DSN is a public client value (VITE_ prefix).
VITE_SENTRY_DSN=
# Fraction of transactions traced (0..1); defaults to 0.1 when unset.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
